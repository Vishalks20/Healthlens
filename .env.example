# Copy this file to ".env" and paste your key. Default provider: Groq (free tier).
# Get a key at https://console.groq.com  (API Keys -> Create API Key)

LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-key-here
GROQ_MODEL=openai/gpt-oss-20b

# ---- Other providers (optional): delete the lines above and uncomment ONE block ----

# Claude (paid):
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-key-here
# CLAUDE_MODEL=claude-sonnet-5-5

# Ollama (free, offline; install from https://ollama.com, then: ollama pull llama3.2):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=llama3.2
# LLM_API_KEY=ollama

# Google Gemini (free tier, key at https://aistudio.google.com):
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash
# LLM_API_KEY=your-gemini-key
# Free tiers and model names change; check each site for what is currently available.
